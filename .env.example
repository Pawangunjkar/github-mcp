# GitHub Connection Details
# Pass via environment variables or connect dynamically via github_connect tool

# Personal Access Token (classic or fine-grained) — generate at https://github.com/settings/tokens
GITHUB_TOKEN=your-github-pat-token-here

# API base URL (default: https://api.github.com; change for GitHub Enterprise Server)
GITHUB_API_URL=https://api.github.com

# Preferred clone/push protocol: 'ssh' or 'https' (default: ssh)
GITHUB_PROTOCOL=ssh

# Request timeout in seconds (default: 30)
GITHUB_TIMEOUT=30

# Credential cache directory (optional, defaults to ~/.github-mcp-cache)
# GITHUB_MCP_CACHE_DIR=/tmp/github-mcp-cache
