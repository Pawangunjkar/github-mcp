# GitHub Connection Details (Optional)
# If not set, the server will ask for credentials in chat via github_connect tool

# Personal Access Token (classic or fine-grained)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your-personal-access-token-here

# API base URL (default: https://api.github.com)
# Change for GitHub Enterprise Server:
# GITHUB_API_URL=https://github.your-company.com/api/v3
GITHUB_API_URL=https://api.github.com

# Preferred clone/push protocol: 'ssh' or 'https' (default: ssh)
GITHUB_PROTOCOL=ssh

# Credential cache directory (optional, defaults to ~/.github-mcp-cache)
# GITHUB_MCP_CACHE_DIR=/custom/cache/path

# Request timeout in seconds (default: 30)
# GITHUB_TIMEOUT=30
